@@ -0,0 +1,46 @@
+package openai
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+)
+
+// deltaContent is a streamed delta.content, which is a string on most endpoints
+// and an array of typed parts on Mistral.
+type deltaContent struct {
+	text      string
+	reasoning string
+}
+
+func (c *deltaContent) UnmarshalJSON(data []byte) error {
+	if !bytes.HasPrefix(bytes.TrimSpace(data), []byte("[")) {
+		return json.Unmarshal(data, &c.text)
+	}
+	var parts []struct {
+		Type     string          `json:"type"`
+		Text     string          `json:"text"`
+		Thinking json.RawMessage `json:"thinking"`
+	}
+	if err := json.Unmarshal(data, &parts); err != nil {
+		return err
+	}
+	var text, reasoning strings.Builder
+	for _, part := range parts {
+		if part.Type == "thinking" {
+			var inner deltaContent
+			if len(part.Thinking) > 0 {
+				if err := json.Unmarshal(part.Thinking, &inner); err != nil {
+					return err
+				}
+			}
+			reasoning.WriteString(inner.text)
+			continue
+		}
+		if part.Type == "text" {
+			text.WriteString(part.Text)
+		}
+	}
+	c.text, c.reasoning = text.String(), reasoning.String()
+	return nil
+}
